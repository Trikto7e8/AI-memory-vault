{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Memory Vault encrypted envelope v1",
  "description": "Portable encrypted backup envelope. The plaintext snapshot must never be stored or transferred outside this envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "kdf", "keyWrapping", "privateKeyEnvelope", "payload"],
  "properties": {
    "format": { "const": "memoria-vault-encrypted" },
    "schemaVersion": { "const": 1 },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hash", "iterations", "salt"],
      "properties": {
        "name": { "const": "PBKDF2" },
        "hash": { "const": "SHA-256" },
        "iterations": { "const": 600000 },
        "salt": { "type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$" }
      }
    },
    "keyWrapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hash", "publicKey", "wrappedDataKey"],
      "properties": {
        "name": { "const": "RSA-OAEP" },
        "hash": { "const": "SHA-256" },
        "publicKey": { "$ref": "#/$defs/base64PublicKey" },
        "wrappedDataKey": { "type": "string", "pattern": "^[A-Za-z0-9+/]{512}$" }
      }
    },
    "privateKeyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "iv", "ciphertext"],
      "properties": {
        "algorithm": { "const": "AES-GCM" },
        "iv": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" },
        "ciphertext": { "$ref": "#/$defs/base64PrivateKeyCiphertext" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "iv", "ciphertext"],
      "properties": {
        "algorithm": { "const": "AES-GCM" },
        "iv": { "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" },
        "ciphertext": { "$ref": "#/$defs/base64PayloadCiphertext" }
      }
    }
  },
  "$defs": {
    "base64PublicKey": {
      "type": "string",
      "minLength": 400,
      "maxLength": 1368,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "base64PrivateKeyCiphertext": {
      "type": "string",
      "minLength": 1336,
      "maxLength": 4000,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "base64PayloadCiphertext": {
      "type": "string",
      "minLength": 24,
      "maxLength": 33554432,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
